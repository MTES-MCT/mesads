{% extends "base_mail.mjml" %}

{% block title %}
MesADS - Expiration de vos droits d'accès
{% endblock %}

{% block content %}
<mj-column>
  <mj-text>
    <p>
      Bonjour,
    </p>
    <p>
      Vos droits de gestionnaire des autorisations de stationnement de {{ demande.ads_manager.content_object.display_fulltext|safe }} vont arriver à terme le {{ demande.expire_at }}.
    </p>
    <ul>
      <li>
        Vous pouvez demander leur renouvellement en vous rendant sur la page suivante : <a href="{{ base_url }}{% url 'app.mes_acces' %}">Mes accès</a>
      </li>
      <li>
        En l'absence d'action de votre part, vos accès expireront automatiquement à la date mentionnée ci-dessus.
      </li>
    </ul>
    <p>
    Nous restons à votre disposition pour tout renseignement complémentaire,
    </p>
    <p>
    Bien cordialement,
    </p>
    <p>
    L'équipe MesADS
    </p>
  </mj-text>
</mj-column>
{% endblock %}
